Options -Indexes
<FilesMatch "(^[.]|[.](env|sql|zip|bak|log|ini|conf|md|py|ps1|bat)$|[~]$)">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(database|scripts|server|backups|dist)(/|$) - [F,L,NC]
RewriteRule ^php/(storage|config|services)(/|$) - [F,L,NC]
</IfModule>

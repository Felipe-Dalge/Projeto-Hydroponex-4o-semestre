# Referência de variáveis de AMBIENTE. PHP não carrega .env automaticamente.
# Defina-as no terminal que inicia PHP ou no ambiente privado do servidor.
HYDROPONEX_DB_HOST=127.0.0.1
HYDROPONEX_DB_PORT=3306
HYDROPONEX_DB_NAME=hydroponex
HYDROPONEX_DB_USER=hydroponex_app
HYDROPONEX_DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL

# Segredo estável para HMAC dos limites de tentativas (exatamente 64 caracteres hexadecimais).
# Gere fora do código: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
HYDROPONEX_AUTH_KEY=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS_ALEATORIOS

# Alternativa compatível com os scripts da etapa anterior.
# Quando presente, HYDROPONEX_DSN prevalece sobre HOST/PORT/NAME acima.
# HYDROPONEX_DSN=mysql:host=127.0.0.1;port=3306;dbname=hydroponex;charset=utf8mb4

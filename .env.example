# Referência de variáveis de AMBIENTE. PHP não carrega .env automaticamente.
# Defina-as no terminal que inicia PHP ou no ambiente privado do servidor.
HYDROPONEX_DB_HOST=127.0.0.1
HYDROPONEX_DB_PORT=3306
HYDROPONEX_DB_NAME=hydroponex
HYDROPONEX_DB_USER=hydroponex_app
HYDROPONEX_DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL

# Segredo estável para HMAC dos limites de tentativas (exatamente 64 caracteres hexadecimais).
# Gere fora do código: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
HYDROPONEX_AUTH_KEY=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS_ALEATORIOS

# Alternativa compatível com os scripts da etapa anterior.
# Quando presente, HYDROPONEX_DSN prevalece sobre HOST/PORT/NAME acima.
# HYDROPONEX_DSN=mysql:host=127.0.0.1;port=3306;dbname=hydroponex;charset=utf8mb4

# XAMPP: MariaDB 10.4.32 validado; importar database/mariadb/hydroponex_mariadb.sql.
# Apache: usar public/server/hydroponex.local.conf.example fora de htdocs.

# Instalador: configuração privada fora de htdocs prevalece quando existe marcador.
# Sem marcador, estas variáveis continuam sendo a configuração da aplicação.

# Convites. Exemplo local com Mailpit, sem autenticação, apenas em loopback.
HYDROPONEX_SMTP_HOST=127.0.0.1
HYDROPONEX_SMTP_PORT=1025
HYDROPONEX_SMTP_SECURITY=none
HYDROPONEX_SMTP_USER=
HYDROPONEX_SMTP_PASSWORD=
HYDROPONEX_SMTP_FROM=convites@example.test
HYDROPONEX_SMTP_FROM_NAME=Hydroponex
HYDROPONEX_PUBLIC_URL=http://localhost/hydroponex

# Opcional quando o Apache publica somente public/ em outro local.
# A dependência precisa ficar fora do diretório publicado.
# HYDROPONEX_MAIL_AUTOLOAD=C:/xampp/hydroponex-private/vendor/autoload.php
